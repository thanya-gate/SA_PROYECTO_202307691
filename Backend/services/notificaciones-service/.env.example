NODE_ENV=development
GRPC_PORT=50056

DATABASE_URL=postgresql://yousac:yousac_secret@localhost:5437/yousac_notificaciones
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Dependencias east-west (gRPC)
AUTH_GRPC_ADDR=localhost:50051
INSCRIPCION_GRPC_ADDR=localhost:50055

# Servidor SMTP. Si SMTP_HOST queda vacío se usa un transporte JSON
# (solo consola/log) para desarrollo local sin infraestructura de correo.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-responder@yousac.edu.gt
MAIL_DEBUG=true

# Worker de la cola de envío
WORKER_INTERVAL_MS=15000
MAX_INTENTOS=5
