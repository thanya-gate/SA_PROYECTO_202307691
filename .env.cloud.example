# ============================================================================
# YoUSAC - variables para docker-compose.cloud.yml (plantilla sin secretos)
# ============================================================================
# Copiar como .env.cloud en la VM y completar los valores reales.

# Imagen publicada por el workflow CI/CD.
REGISTRY_BASE=us-central1-docker.pkg.dev/yousac-202300396-2026/yousac
IMAGE_TAG=main

# Dominio/IP publico y correo usado por Caddy para ACME.
DOMAIN=yousac-thany.duckdns.org
ACME_EMAIL=yousac-ads@gmail.com

# Secretos: reemplazar en la VM; no subir .env.cloud al repositorio.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
POSTGRES_USER=CAMBIAR_USUARIO
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Nombre de conexion de Cloud SQL. Una instancia pequena puede alojar las seis
# bases independientes del microservicio usadas por esta validacion.
# proyecto:region:instancia
CLOUD_SQL_CONNECTION_NAME_AUTH=PROYECTO:REGION:INSTANCE_AUTH
CLOUD_SQL_CONNECTION_NAME_CATALOG=PROYECTO:REGION:INSTANCE_CATALOG
CLOUD_SQL_CONNECTION_NAME_REPRODUCCION=PROYECTO:REGION:INSTANCE_REPRODUCCION
CLOUD_SQL_CONNECTION_NAME_ANALITICA=PROYECTO:REGION:INSTANCE_ANALITICA
CLOUD_SQL_CONNECTION_NAME_INSCRIPCION=PROYECTO:REGION:INSTANCE_INSCRIPCION
CLOUD_SQL_CONNECTION_NAME_NOTIFICACIONES=PROYECTO:REGION:INSTANCE_NOTIFICACIONES

# Bases de datos independientes por microservicio.
AUTH_DB=yousac_auth
CATALOG_DB=yousac_catalog
REPRODUCCION_DB=yousac_reproduccion
ANALITICA_DB=yousac_analitica
INSCRIPCION_DB=yousac_inscripcion
NOTIFICACIONES_DB=yousac_notificaciones

# Redis local de la VM para la prueba de paridad. En una instalacion con
# Memorystore se reemplaza por su IP privada.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth/OAuth. Para una prueba controlada puede usarse el IdP simulado.
ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt
OAUTH_PROVIDER=mock
OAUTH_MOCK_ENABLED=true
OAUTH_ISSUER_PUBLIC=https://yousac-thany.duckdns.org/mock-oauth
OAUTH_REDIRECT_URI=https://yousac-thany.duckdns.org/oauth/callback
OAUTH_CLIENT_ID=yousac-web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yousac-thany.duckdns.org/oauth/callback
SEED_DEMO=false

# Ajustes del perfil de validacion por IP (usar valores seguros de dominio en
# una instalacion definitiva con HTTPS).
CATALOG_NODE_ENV=production
CADDYFILE=Caddyfile
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
FORWARD_PROTO=https

# SMTP usado por notificaciones.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_DEBUG=false

# Almacenamiento multimedia.
STORAGE_BACKEND=gcs
GCS_BUCKET_VIDEOS=yousac-videos
GCS_BUCKET_MATERIAL=yousac-material
GCS_PUBLIC_BASE_URL=
