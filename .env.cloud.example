
# --- Google Cloud Platform ---
GCP_PROJECT_ID=tu-proyecto-gcp                               # ID de tu proyecto en GCP
GCP_REGION=us-central1                                       # Región de las instancias

# --- Cloud SQL Connection Names ---
# Obten los nombres de conexión de cada instancia Cloud SQL:
#   gcloud sql instances describe [INSTANCE_NAME] --format="value(connectionName)"
CLOUD_SQL_CONNECTION_NAME_AUTH=tu-proyecto-gcp:us-central1:yousac-auth-db
CLOUD_SQL_CONNECTION_NAME_CATALOG=tu-proyecto-gcp:us-central1:yousac-catalog-db
CLOUD_SQL_CONNECTION_NAME_REPRODUCCION=tu-proyecto-gcp:us-central1:yousac-reproduccion-db
CLOUD_SQL_CONNECTION_NAME_ANALITICA=tu-proyecto-gcp:us-central1:yousac-analitica-db
CLOUD_SQL_CONNECTION_NAME_INSCRIPCION=tu-proyecto-gcp:us-central1:yousac-inscripcion-db
CLOUD_SQL_CONNECTION_NAME_NOTIFICACIONES=tu-proyecto-gcp:us-central1:yousac-notificaciones-db

# --- Cloud Storage ---
# STORAGE_BACKEND=gcs sube los videos/materiales al bucket y guarda su URL
# pública en la base de datos. Con STORAGE_BACKEND=local se sirve desde el
# disco montado con gcsfuse vía nginx (comportamiento anterior).
STORAGE_BACKEND=gcs
GCS_BUCKET_VIDEOS=yousac-videos                              # Bucket de Cloud Storage para videos
GCS_BUCKET_MATERIAL=yousac-material                          # Bucket para materiales (PDF, etc.)
GCS_PUBLIC_BASE_URL=                                         # Opcional: dominio CDN propio; vacío = storage.googleapis.com/<bucket>

# --- Memorystore (Redis) ---
REDIS_HOST=1270.0.1.1   # IP del endpoint de Memorystore (host-only)
REDIS_PORT=6379
REDIS_PASSWORD=           # Contraseña de Redis (si está configurada)

# --- PostgreSQL Database Names ---
AUTH_DB=yousac_auth
CATALOG_DB=yousac_catalogo
REPRODUCCION_DB=yousac_reproduccion
ANALITICA_DB=yousac_analitica
INSCRIPCION_DB=yousac_inscripcion
NOTIFICACIONES_DB=yousac_notificaciones

# --- PostgreSQL Credentials ---
POSTGRES_USER=yousac
POSTGRES_PASSWORD=                                            # Se gestiona vía Secret Manager en GCP

# --- JWT ---
JWT_SECRET=                                                    # Clave JWT segura (32+ chars) — Se gestiona vía Secret Manager

# --- Sesión ---
ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt  # Dominios institucionales permitidos
SESSION_COOKIE_NAME=yousac_session

# --- DuckDNS (HTTPS) ---
# Registra un subdominio en https://www.duckdns.org y apúntalo a la IP pública
# de tu VM GCP. Caddy lo usará para obtener un certificado TLS de Let's Encrypt.
DOMAIN=yousac-thany.duckdns.org
ACME_EMAIL=tu-email@gmail.com                                 # Email para Let's Encrypt

# --- OAuth 2.0 ---
# Si usas Google OAuth real: configura GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET
# en Google Cloud Console, y registra redirect_uri:
#   https://yousac-thany.duckdns.org/oauth/callback
OAUTH_PROVIDER=google                                          # google o mock
OAUTH_ISSUER_PUBLIC=https://yousac-thany.duckdns.org/mock-oauth     # URL pública del IdP (mock)
OAUTH_REDIRECT_URI=https://yousac-thany.duckdns.org/oauth/callback   # URL de callback OAuth
OAUTH_CLIENT_ID=yousac-web
OAUTH_MOCK_ENABLED=false                                       # Habilita IdP mock (login con credenciales)
GOOGLE_CLIENT_ID=                                              # Client ID de Google OAuth
GOOGLE_CLIENT_SECRET=                                          # Client Secret de Google OAuth
GOOGLE_REDIRECT_URI=https://yousac-thany.duckdns.org/oauth/callback

# --- YouTube Data API (opcional) ---
# Si se configura, al pegar una URL de YouTube se detectará automáticamente
# la duración del video. Si no se configura, la duración para videos de
# YouTube debe establecerse manualmente.
YOUTUBE_API_KEY=                                              # API Key de YouTube Data API v3

# --- SMTP (Notificaciones) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                                                     # Email institucional
SMTP_PASS=                                                     # Contraseña de aplicación
SMTP_FROM=                                                     # Remitente de emails

# --- Frontend ---
VITE_API_BASE_URL=/api                                        # Ruta base de la API (proxy nginx)

# --- Cache ---
CACHE_TTL_SEGUNDOS=600                                         # TTL de caché Redis (10 min)
