# =====================================================================
# terraform.tfvars.example - Plantilla de variables para YoUSAC (Fase 3)
# =====================================================================
# Este archivo SI se versiona a proposito: documenta que variables acepta el
# modulo y con que valores tiene sentido ejecutarlo.
#
# Para usarlo:
#   1. cp terraform.tfvars.example terraform.tfvars
#   2. ajusta lo que necesites
#   3. terraform plan
#
# El terraform.tfvars que crees NO se versiona: esta en el .gitignore, junto
# con los .tfstate, porque son los archivos donde un secreto terminaria
# guardado en texto plano.
#
# En la practica NO hace falta crear el .tfvars: todas las variables ya
# tienen valores por defecto, asi que `terraform plan` funciona directo. Este
# archivo sirve sobre todo para cambiar de region o de tamano de maquina
# sin tocar el codigo .tf.
#
# Topologia: vpc-yousac 10.20.0.0/16 con tres capas (perimetral, aplicacion,
# datos) y salida a internet por Cloud NAT (las VMs no tienen IP publica).
# =====================================================================

# --- Proyecto y ubicacion ---------------------------------------------------

project_id = "yousac-202300396-2026"
region     = "us-central1"
zone       = "us-central1-a"

# --- Red -------------------------------------------------------------------

network_name           = "vpc-yousac"
vpc_cidr               = "10.20.0.0/16"
subnet_perimetral      = "subnet-yousac-perimetral"
subnet_perimetral_cidr = "10.20.1.0/24"
subnet_aplicacion      = "subnet-yousac-aplicacion"
subnet_aplicacion_cidr = "10.20.2.0/24"
subnet_datos           = "subnet-yousac-datos"
subnet_datos_cidr      = "10.20.3.0/24"

# IPs internas estaticas. Deben caer dentro del CIDR de su subred; si no, la
# API de Compute Engine rechaza la instancia.
development_internal_ip   = "10.20.2.10"
observability_internal_ip = "10.20.3.10"

# --- Computo ----------------------------------------------------------------

development_instance_name = "vm-dev-yousac"
development_machine_type  = "e2-micro"

# Elasticsearch necesita al menos 8 GB de RAM; e2-standard-2 (2 vCPU / 8 GB).
observability_instance_name  = "vm-observability-yousac"
observability_machine_type   = "e2-standard-2"
observability_disk_size_gb   = 60

boot_disk_image   = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
boot_disk_size_gb = 30

# --- Recursos gestionados (adoptados via import) ----------------------------

gke_cluster_name        = "yousac-prod"
sql_instance_name       = "yousac-p6-db"
bucket_videos           = "yousac-videos"
bucket_material         = "yousac-material"
artifact_repository_id  = "yousac"
static_ip_name          = "yousac-prod-ip"

# Contrasena del usuario de Cloud SQL. NO se escribe aqui: se inyecta por
# entorno antes de ejecutar Terraform:
#   $env:TF_VAR_postgres_password = "..."
# postgres_password = ""

# --- Acceso SSH -------------------------------------------------------------

ssh_username = "ubuntu"
# Una .pub por integrante; todas quedan autorizadas en las VMs.
ssh_public_key_paths = [
  "~/.ssh/yousac_ed25519.pub",
  # "~/.ssh/companero_ed25519.pub",
]
ssh_private_key_path = "~/.ssh/yousac_ed25519"

# --- Firewall ---------------------------------------------------------------

# El default es el rango de Identity-Aware Proxy: las VMs no exponen SSH a
# internet y Ansible entra por un tunel de gcloud. Requiere el rol
# roles/iap.tunnelResourceAccessor sobre el proyecto.
#
# Para una demostracion desde una IP fija, se puede estrechar a:
#   allowed_ssh_cidr = "203.0.113.45/32"
allowed_ssh_cidr = "35.235.240.0/20"

# Rangos que llegan a la VM de observabilidad desde el cluter GKE: la red
# `default` (10.128.0.0/9) y los pods del Autopilot (172.16.0.0/14).
gke_source_ranges = ["10.128.0.0/10", "172.16.0.0/12"]

# Etiquetas de red. Las reglas de firewall apuntan a estas etiquetas, nunca a
# una IP, para que sobrevivan a un cambio de direccion.
network_tags     = ["yousac-vm"]
development_tag  = "development"
observability_tag = "observability"
