---
# Plantilla de los secretos del stack ELK.
# Copia este archivo como secrets.yml (junto a este) y pon los valores reales.
# secrets.yml esta ignorado por git; este .example SI se versiona.

elastic_password: "CAMBIA-esto"
kibana_system_password: "CAMBIA-esto"
# Clave de cifrado de Kibana, minimo 32 caracteres.
kibana_encryption_key: "CAMBIA-esto-minimo-32-caracteres-xxxx"
